# Generated by lzctl {{ .Version }} — safe to edit
terraform {
  required_version = ">= 1.9.0"
  required_providers {
    alz = {
      source  = "Azure/alz"
      version = "~> 0.22"
    }
    azapi = {
      source  = "Azure/azapi"
      version = "~> 2.13"
    }
  }
}

# Le module ALZ lit les définitions (architecture, policies, rôles) dans la bibliothèque ALZ,
# épinglée ici par version.
provider "alz" {
  library_references = [
    {
      path = "platform/alz"
      ref  = "2026.10.0"
    }
  ]
}

data "azapi_client_config" "current" {}

module "management_groups" {
  source  = "Azure/avm-ptn-alz/azurerm"
  version = "0.22.0"

  architecture_name  = "alz"
  location           = var.location
  parent_resource_id = data.azapi_client_config.current.tenant_id
  enable_telemetry   = false
}
